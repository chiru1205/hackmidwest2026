<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="arch" name="1. System architecture">
    <mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Civic Flow — System Architecture&lt;/b&gt;&lt;br&gt;HackMidwest 2026 · 3 people · one Linode on Akamai Cloud · solid = build for demo, dashed = optional / only if time" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1300" height="50" as="geometry"/>
        </mxCell>

        <!-- CLIENTS -->
        <mxCell id="cl" value="CLIENTS (P3 builds)" style="swimlane;startSize=30;fontStyle=1;html=1;whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="270" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;Citizen phone app&lt;/b&gt;&lt;br&gt;Vite + React PWA&lt;br&gt;camera + GPS, compress to JPEG&lt;br&gt;report, track status, XP and badges" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="cl">
          <mxGeometry x="15" y="45" width="240" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;Ops Theatre (big screen)&lt;/b&gt;&lt;br&gt;MapLibre + OpenFreeMap&lt;br&gt;live pipeline, counters, DevRev feed&lt;br&gt;Simulate: 1,243 reports → 37 pins" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="cl">
          <mxGeometry x="15" y="180" width="240" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Vendor page&lt;/b&gt;&lt;br&gt;assigned work orders&lt;br&gt;Mark fixed · before / after photo" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="cl">
          <mxGeometry x="15" y="315" width="240" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;?demo=1 panel&lt;/b&gt;&lt;br&gt;mock-fixtures mode, location override,&lt;br&gt;backup video" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="cl">
          <mxGeometry x="15" y="430" width="240" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="k" value="&lt;b&gt;KCMO 311 open data&lt;/b&gt;&lt;br&gt;dataset d4px-6rwg snapshot&lt;br&gt;seed pins + City Impact numbers" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="270" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="n" value="&lt;b&gt;Report lifecycle&lt;/b&gt;&lt;br&gt;1 snap photo + GPS&lt;br&gt;2 Caddy → FastAPI&lt;br&gt;3 engine dedup (no LLM)&lt;br&gt;4 merge +1, or new cluster&lt;br&gt;5 Intake vision triage&lt;br&gt;6 judge? → priority → dispatch → ticket&lt;br&gt;7 poll DevRev stage&lt;br&gt;8 SSE → phone shows Fixed" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="270" height="175" as="geometry"/>
        </mxCell>

        <!-- AKAMAI CLOUD -->
        <mxCell id="a0" value="AKAMAI CLOUD — one Linode g6-standard-2, Docker Compose, HTTPS on port 443" style="swimlane;startSize=30;fontStyle=1;html=1;whiteSpace=wrap;rounded=1;fillColor=#e1f0ff;strokeColor=#0a6cc4;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="370" y="70" width="980" height="960" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;Caddy&lt;/b&gt; — automatic HTTPS · serves the built web app (same origin, no CORS) · proxies /api · SSE flush enabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#0a6cc4;fontSize=11;" vertex="1" parent="a0">
          <mxGeometry x="20" y="45" width="940" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="f0" value="FASTAPI — one uvicorn worker (P1 builds)" style="swimlane;startSize=28;fontStyle=1;html=1;whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;" vertex="1" parent="a0">
          <mxGeometry x="20" y="110" width="940" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;REST /api&lt;/b&gt;&lt;br&gt;POST /reports&lt;br&gt;GET /clusters, /me&lt;br&gt;/vendor, /admin (reset, simulate)&lt;br&gt;/healthz" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="f0">
          <mxGeometry x="15" y="40" width="210" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;SSE live events&lt;/b&gt;&lt;br&gt;agent.node, cluster.*, ticket.*" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="f0">
          <mxGeometry x="15" y="185" width="210" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;Dedup + priority engine&lt;/b&gt; (plain Python, zero LLM calls)&lt;br&gt;geo candidates via Valkey GEOSEARCH · per-category radius (pothole 15–40 m)&lt;br&gt;score = 0.50 geo + 0.20 category + 0.15 image + 0.15 time&lt;br&gt;≥ 0.75 merge · 0.50–0.75 ask judge · &amp;lt; 0.50 new cluster&lt;br&gt;priority 0–100, reporters log-scaled (1,000 minor reports still &amp;lt; one severity-5 near a school)&lt;br&gt;fraud: pHash, rate limits · XP ledger · per-cell asyncio lock" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="f0">
          <mxGeometry x="245" y="40" width="360" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;Orchestrator&lt;/b&gt;&lt;br&gt;await agent.invoke_async (never a sync call)&lt;br&gt;builds the Graph per request&lt;br&gt;logs once after stream_async finishes&lt;br&gt;DevRev poller (~20 s) · watchdog&lt;br&gt;DEMO_MODE · fallback flags:&lt;br&gt;MODEL_PROVIDER, VISION, DEVREV_MODE, STORAGE" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="f0">
          <mxGeometry x="625" y="40" width="300" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="s0" value="AWS STRANDS AGENTS 1.59 (Python) — P1 builds, P2 pairs on smoke tests" style="swimlane;startSize=28;fontStyle=1;html=1;whiteSpace=wrap;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;" vertex="1" parent="a0">
          <mxGeometry x="20" y="430" width="940" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;Intake Agent&lt;/b&gt;&lt;br&gt;standalone, runs first&lt;br&gt;photo → category, severity, hazard, valid?&lt;br&gt;structured_output_model (Bedrock only)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="s0">
          <mxGeometry x="15" y="40" width="185" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;dedup_judge?&lt;/b&gt;&lt;br&gt;only the 0.5–0.75 band&lt;br&gt;strict JSON prompt, max_tokens set, Pydantic-validated" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="s0">
          <mxGeometry x="215" y="40" width="170" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;priority&lt;/b&gt;&lt;br&gt;writes the rationale; numbers come from engine code&lt;br&gt;calls a tool through MCPClient" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="s0">
          <mxGeometry x="400" y="40" width="170" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;dispatch&lt;/b&gt;&lt;br&gt;plain Python creates ticket + assigns vendor&lt;br&gt;LLM writes title and body only&lt;br&gt;goal: under 10 s photo → ticket" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="s0">
          <mxGeometry x="585" y="40" width="170" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;Hooks + MCP&lt;/b&gt;&lt;br&gt;BeforeToolCall guard&lt;br&gt;AfterToolCall audit&lt;br&gt;tiny in-repo MCP server" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="s0">
          <mxGeometry x="770" y="40" width="155" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="Graph (built per request, pure read-only edge conditions): dedup_judge? → priority → dispatch" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=2;fontSize=11;" vertex="1" parent="s0">
          <mxGeometry x="215" y="185" width="540" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="a2" value="&lt;b&gt;Valkey&lt;/b&gt; (hot store)&lt;br&gt;geo:open:{group} — GEOADD / GEOSEARCH, ZREM&lt;br&gt;rate limits, pHash, leaderboard sorted set&lt;br&gt;EdgeKV-shaped cell cache" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="a0">
          <mxGeometry x="20" y="710" width="300" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;Postgres (container)&lt;/b&gt; (durable)&lt;br&gt;users, clusters, reports, ledger, kv_meta&lt;br&gt;events (jsonb): judge_log, agent_traces&lt;br&gt;no PostGIS, no pgvector" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="a0">
          <mxGeometry x="340" y="710" width="300" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;Akamai Object Storage&lt;/b&gt;&lt;br&gt;S3-compatible, bucket civicflow-photos&lt;br&gt;server-side upload with boto3&lt;br&gt;fallback: local disk (STORAGE=local)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="a0">
          <mxGeometry x="660" y="710" width="300" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="&quot;Powered by Akamai&quot; strip in the UI is generated from /healthz live flags, so it only lists services that actually served the last report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0a6cc4;dashed=1;fontSize=11;" vertex="1" parent="a0">
          <mxGeometry x="20" y="870" width="940" height="45" as="geometry"/>
        </mxCell>

        <!-- EXTERNAL SERVICES -->
        <mxCell id="e1" value="&lt;b&gt;AWS Bedrock&lt;/b&gt;&lt;br&gt;Claude Haiku 5.5 — vision intake&lt;br&gt;us.anthropic.claude-haiku-5-5&lt;br&gt;fallback: Anthropic API key" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="120" width="260" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;Akamai hosted inference&lt;/b&gt;&lt;br&gt;ws.akamai-workshops.com/v1&lt;br&gt;hackathon-chat — judge + priority text&lt;br&gt;hackathon-image — badge art&lt;br&gt;60 requests/min per team, no vision" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#e1f0ff;strokeColor=#0a6cc4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="285" width="260" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;DevRev (separate Civic Flow org)&lt;/b&gt;&lt;br&gt;REST api.devrev.ai (PAT)&lt;br&gt;works.create / update / get&lt;br&gt;one ticket per unique pothole&lt;br&gt;vendors = groups + tags&lt;br&gt;stage names → citizen-facing status" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="470" width="260" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="&lt;b&gt;DevRev Computer (optional)&lt;/b&gt;&lt;br&gt;dedup-mcp + SKILL.md&lt;br&gt;Enterprise-Bench data only&lt;br&gt;go / no-go at 2:00 PM" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="680" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="&lt;b&gt;Akamai EdgeWorker + EdgeKV&lt;/b&gt;&lt;br&gt;dormant bundle in /edge&lt;br&gt;only if sandbox access is granted" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;dashed=1;fillColor=#e1f0ff;strokeColor=#0a6cc4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1410" y="830" width="260" height="100" as="geometry"/>
        </mxCell>

