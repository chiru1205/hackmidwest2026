# --- flags: LOCAL DEFAULTS (Akamai key only; no AWS, no DevRev yet) ---
MODEL_PROVIDER=akamai         # akamai | bedrock | anthropic  (text agents use Akamai hosted chat)
AGENTS_MODE=graph             # graph | det
VISION=off                    # on needs Bedrock or an Anthropic key; off = category chips + note
EMBED=off                     # on | off (cut by default)
DEVREV_MODE=mock               # mock = built-in ticket board with DevRev-shaped payloads | live
STORAGE=local                  # local | s3 (Akamai Object Storage)
EDGEKV_BACKEND=memory         # valkey | edge
JUDGE_MODEL=akamai            # akamai | haiku
PRIORITY_MODEL=akamai         # akamai | haiku
SIM_TICKETS=5                 # real DevRev tickets for top-N simulated clusters (0 = none)

# --- Bedrock / Anthropic ---
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2
BEDROCK_HAIKU_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0     # 5.5 is gated on new accounts
ANTHROPIC_API_KEY=
ANTHROPIC_HAIKU_ID=claude-haiku-5-5                 # verify [V1]

# --- Akamai ---
AKAMAI_AI_BASE_URL=https://ws.akamai-workshops.com/v1
AKAMAI_AI_KEY=                                      # hk_...
AKAMAI_CHAT_MODEL=hackathon-chat
AKAMAI_EMBED_MODEL=hackathon-embedding
AKAMAI_RPM_CAP=50
S3_ENDPOINT=                                        # per bucket region [V15]
S3_BUCKET=civicflow-photos
S3_KEY=
S3_SECRET=

# --- Data plane ---
DATABASE_URL=postgresql://civicflow:civicflow@localhost:5432/civicflow
VALKEY_URL=redis://localhost:6379/0

# --- DevRev (Civic Flow org, NOT the Enterprise-Bench playground) ---
DEVREV_PAT=
DEVREV_OWNER_DEVU=
DEVREV_PART_STREETS=
DEVREV_PART_LIGHTING=
DEVREV_PART_WATER=
DEVREV_PART_SANITATION=
DEVREV_ACCOUNT_ID=
DEVREV_WEBHOOK_SECRET=

# --- App ---
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_TOKEN=
MCP_BEARER_TOKEN=
VITE_MOCK=0

# --- API layer ---
DB_PATH=                      # default code/data/civicflow.db
DEMO_MODE=true                # relaxes accuracy / rate limit / duplicate-photo checks
API_AGENT_TIMEOUT=25          # seconds before an agent call falls back

# --- Roles (demo-level gate for the city portal; leave empty to disable enforcement) ---
CITY_TOKEN=civicflow-city-demo
